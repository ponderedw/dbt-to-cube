# Deployment Environment
DEPLOY_ENV='local'

# LLM Model Configuration
# Choose one of the following:
LLM_MODEL_ID='anthropic:claude-3-5-sonnet-20241022'
# LLM_MODEL_ID='openai:gpt-4'
# LLM_MODEL_ID='openai:gpt-4o-mini'
# LLM_MODEL_ID='bedrock:anthropic.claude-3-5-sonnet-20240620-v1:0'

# Embedding Model Configuration
EMBEDDING_MODEL='openai:text-embedding-3-small'
# EMBEDDING_MODEL='openai:text-embedding-ada-002'

# API Keys
# Anthropic (for Claude models)
ANTHROPIC_API_KEY='your-anthropic-api-key-here'

# OpenAI (for GPT models and embeddings)
OPENAI_API_KEY='your-openai-api-key-here'

# AWS Credentials (for Bedrock models)
# AWS_ACCESS_KEY_ID='your-aws-access-key-id'
# AWS_SECRET_ACCESS_KEY='your-aws-secret-access-key'
# AWS_DEFAULT_REGION='us-east-1'

# Vector Database
MILVUS_SERVER_URI='http://milvus-standalone:19530'
# Optional: Milvus authentication (if your Milvus instance requires it)
# MILVUS_USER='root'
# MILVUS_PASSWORD='your-milvus-password'

# Cube.js API Connection
# Base URL for Cube.js (default is for docker-compose setup)
# CUBE_URL='http://cube_api:4000'
# Optional: Cube.js API secret for JWT token generation
# CUBEJS_API_SECRET='your-cube-api-secret'

# Cube.js GraphQL Retry Configuration
# Max retries for "Continue wait" errors during pre-aggregation building (default: 3)
# CUBE_GRAPHQL_MAX_RETRIES=3
# Delay in seconds between retries (default: 5)
# CUBE_GRAPHQL_RETRY_DELAY=5

# Security
SECRET_KEY='change-this-secret-key-in-production'
FAST_API_ACCESS_SECRET_TOKEN='change-this-access-token-in-production'

# Streamlit UI Configuration
# Password protection for the UI
# Leave empty to disable password protection (not recommended for production)
STREAMLIT_PASSWORD=your-streamlit-password-here

# FastAPI backend URL (default: http://fastapi:8080)
# Override this if FastAPI is running on a different host/port
# FASTAPI_URL=http://fastapi:8080

# Optional - LangSmith Tracing
# LANGCHAIN_TRACING_V2='true'
# LANGCHAIN_API_KEY='your-langsmith-api-key'
# LANGCHAIN_PROJECT='cube-rag'
