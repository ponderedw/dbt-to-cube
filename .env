# Database connection
CUBEJS_DB_TYPE=postgres
CUBEJS_DB_HOST=postgres
CUBEJS_DB_NAME=education_dw
CUBEJS_DB_USER=dbt_user
CUBEJS_DB_PASS=dbt_password
CUBEJS_DB_PORT=5432
CUBEJS_SCHEDULED_REFRESH=true

# Cube.js configuration
CUBEJS_API_SECRET=your_secret_key_change_this_in_production
CUBEJS_DEV_MODE=true
CUBEJS_WEB_SOCKETS=true

# Schema location  
CUBEJS_SCHEMA_PATH=/cube/conf/cubes_correct

# Disable CubeStore (use PostgreSQL directly)
CUBEJS_EXTERNAL_DEFAULT=true

# Refresh settings
CUBEJS_REFRESH_WORKER=true
CUBEJS_SCHEDULED_REFRESH_TIMER=3600

# Security
CUBEJS_CORS_ALLOW_ORIGIN=http://localhost:4000,http://localhost:3000

# Logging
CUBEJS_LOG_LEVEL=info
